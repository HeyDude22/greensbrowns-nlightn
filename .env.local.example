# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only (admin actions, cron). Code reads NEXT_SUPABASE_SERVICE_ROLE_KEY.
NEXT_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3001

# GreensBrowns legal entity (embedded in BWG service agreements)
GB_LEGAL_ENTITY_NAME=NLightN Technologies Pvt Ltd
GB_REGISTERED_ADDRESS=
GB_PAN=
GB_GSTIN=
GB_CONTACT_EMAIL=ops@greensbrowns.in
GB_CONTACT_PHONE=

# Meta WhatsApp Cloud API
META_PHONE_NUMBER_ID=
META_WHATSAPP_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
# Meta App Secret — used to verify X-Hub-Signature-256 on inbound webhooks
META_APP_SECRET=
# Template language code as approved in WhatsApp Manager (e.g. en, en_US, en_IN)
META_WA_TEMPLATE_LANG=en

# One-off (guest) WhatsApp pickups — system guest ids seeded by migration 00052.
# These MUST match the fixed UUIDs in supabase/migrations/00052_*.sql.
SYSTEM_GUEST_PROFILE_ID=00000000-0000-0000-0000-0000000000aa
SYSTEM_GUEST_ORG_ID=00000000-0000-0000-0000-0000000000bb

# Twilio WhatsApp (legacy)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Google Distance Matrix API
GOOGLE_MAPS_API_KEY=

# Email (Google Workspace SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=

# Razorpay (one-off pickup payment links)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set when creating the webhook in the Razorpay dashboard.
# Webhook URL to register: https://<your-domain>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# Webhook & Cron Security
CRON_SECRET=
