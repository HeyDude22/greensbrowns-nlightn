# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only (admin actions, cron). Code reads NEXT_SUPABASE_SERVICE_ROLE_KEY.
NEXT_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Meta WhatsApp Cloud API
META_PHONE_NUMBER_ID=
META_WHATSAPP_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
# Template language code as approved in WhatsApp Manager (e.g. en, en_US, en_IN)
META_WA_TEMPLATE_LANG=en

# Twilio WhatsApp (legacy)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Google Distance Matrix API
GOOGLE_MAPS_API_KEY=

# Email (Google Workspace SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=

# Webhook & Cron Security
CRON_SECRET=
